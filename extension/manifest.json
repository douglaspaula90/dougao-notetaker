{
  "manifest_version": 3,
  "name": "DougãoCast",
  "version": "1.1.1",
  "description": "Grava e transcreve reuniões do Google Meet automaticamente.",
  "permissions": [
    "tabCapture",
    "tabs",
    "storage",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://187.77.56.193:3010/*",
    "http://localhost:3010/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DougãoCast — abrir painel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}

# ── Dougao Notetaker — Variáveis de Ambiente ──────────────────────────────────
# Copie para .env e preencha os valores

# ── OpenAI (platform.openai.com → API Keys) ───────────────────────────────────
OPENAI_API_KEY=sk-...

# ── HuggingFace (huggingface.co → Settings → Access Tokens → Read) ────────────
# Gratuito. Necessário para diarização de speakers com pyannote.
HUGGINGFACE_TOKEN=hf_...

# ── Conta Google do Bot ───────────────────────────────────────────────────────
# A conta que entra nas reuniões como "Dougao Notetaker 🎙️"
BOT_GOOGLE_EMAIL=dougaonotetaker@gmail.com
BOT_GOOGLE_PASSWORD=sua_senha_aqui

# ── Comportamento do Bot (opcionais) ──────────────────────────────────────────
# Quantos minutos antes da reunião o bot deve entrar
JOIN_BEFORE_MINUTES=2
# Quantos segundos aguardar sozinho antes de sair
LINGER_AFTER_EMPTY_SECS=30
